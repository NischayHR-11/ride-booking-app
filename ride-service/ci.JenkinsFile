@Library("ci@master") _

MavenDockerPublish(
    'tenant': 'omega',
    'pipelineTimeout': '19',
    'enableCodeSonarSastScan': true,
    'enableCodeSonarSastGating': false,
    'codeSonarScanCommand': "mvn sonar:sonar -Dsonar.projectKey=ride-service -Dsonar.projectName=\"ride-service\" -Dsonar.branch.name=${params.gitBranch ?: 'master'}",
    'mavenBuildCommand': 'mvn clean package',
    'mavenDeployCommand': 'mvn clean deploy',
    'disableImagePublish': false,
    'jdkVersion': '17',
    'publishHelmChart': true,
    'publishDdlArtifacts': true
)